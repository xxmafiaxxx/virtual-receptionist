rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Encrypted integration secrets are server-only. Admin SDK access is governed by IAM.
    match /users/{uid}/private/{document=**} {
      allow read, write: if false;
    }
    // Appointments are read and written only by the server (Admin SDK / kiosk + admin routes).
    match /users/{uid}/appointments/{document=**} {
      allow read, write: if false;
    }
    // Agent tasks are managed only through the server (admin routes + future agent worker).
    match /users/{uid}/tasks/{document=**} {
      allow read, write: if false;
    }
    // Shared practice data (settings, insurance payers) is written only by the
    // server so every admin user of the practice sees the same truth.
    match /practices/{document=**} {
      allow read, write: if false;
    }
    // Kiosk token -> practice mapping is resolved server-side only; never exposed to clients.
    match /kiosk-links/{token} {
      allow read, write: if false;
    }
    // Outbound campaigns (and their per-call subdocs) are orchestrated only by the server worker.
    match /users/{uid}/campaigns/{document=**} {
      allow read, write: if false;
    }
  }
}
