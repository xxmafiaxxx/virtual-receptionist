# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AI_MODEL_PROVIDER=openai
LOCAL_MODEL_URL=http://localhost:11434
DATABASE_URL=

# Firebase Web SDK identifiers. These are intentionally available to the browser.
# Protect Firebase data with Authentication, Security Rules, and App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Restrict admin access. Use comma-separated email addresses and/or one domain.
ADMIN_GOOGLE_EMAILS=admin@example.com
ADMIN_GOOGLE_DOMAIN=

# Firebase Admin SDK (server only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared practice data doc id in Firestore (practices/{PRACTICE_ID}).
# All admin users read the same settings/payers. Change only for multi-practice.
PRACTICE_ID=default
